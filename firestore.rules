rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Movies & Shorts: everyone can read (so uploads are visible to all users),
    // only signed-in users can create/publish new content.
    match /movies/{movieId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /shorts/{shortId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.creatorId == request.auth.uid;
    }

    // Comments: public read, only the author can write/delete their own comment.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Everything else (watchlist, watch history, likes, coins, tasks) is
    // private per user: a user can only read/write their own documents.
    match /watchlist/{docId} {
      allow read, write: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /watch_history/{docId} {
      allow read, write: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /likes/{docId} {
      allow read, write: if request.auth != null;
    }

    match /coins/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /coin_transactions/{docId} {
      allow read, write: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /task_completions/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
